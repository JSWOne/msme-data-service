# Local development. Copy to .env (git-ignored) and fill in.
# DB is Cloud SQL instance ccp-qa (jswone-qa-356112:asia-south1:ccp-qa).
# Start the proxy first (public IP 35.200.227.191 is an alternative, but needs SSL + an authorized network):
#   cloud-sql-proxy jswone-qa-356112:asia-south1:ccp-qa --port 5433
APP_ENV=local
PORT=8080
LOG_LEVEL=debug
# Optional route prefix, e.g. /msme-data-service to mirror QA. Empty = routes at the root.
BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=bq_to_pg
DB_USER=
DB_PASSWORD=

# Comma-separated; each key >= 16 chars. Generate with: openssl rand -hex 32
API_KEYS=
