# Local development. Copy to .env (git-ignored) and fill in.
# Start the proxy first:
#   cloud-sql-proxy jswone-qa-356112:asia-south1:ccp-qa --port 5433
APP_ENV=local
PORT=8080
LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=bq_to_pg
DB_USER=
DB_PASSWORD=

# Comma-separated; each key >= 16 chars. Generate with: openssl rand -hex 32
API_KEYS=
