# QA — branch release/gke. Sourced by deploy/deploy.sh. No secrets here.
APP_ENV=qa
GCP_PROJECT=jswone-qa-356112
REGION=asia-south1
# Cloud SQL instance ccp-qa (public IP 35.200.227.191 — used for local dev, not by Cloud Run)
INSTANCE_CONNECTION_NAME=jswone-qa-356112:asia-south1:ccp-qa
DB_NAME=bq_to_pg
# Path prefix the load balancer forwards unchanged (https://qa.msme.jswone.in/msme-data-service/)
BASE_PATH=/msme-data-service

AR_REPO=TODO-artifact-registry-repo
SERVICE_ACCOUNT=msme-data-service@jswone-qa-356112.iam.gserviceaccount.com

# Secret Manager secret names (same project)
SECRET_DB_USER=msme-db-user
SECRET_DB_PASSWORD=msme-db-password
SECRET_API_KEYS=msme-api-keys

LOG_LEVEL=info
POOL_MAX=5
STATEMENT_TIMEOUT_MS=10000

# Cloud Run sizing / networking
MIN_INSTANCES=0
MAX_INSTANCES=3
CONCURRENCY=40
CPU=1
MEMORY=512Mi
INGRESS=all            # all | internal | internal-and-cloud-load-balancing
SMOKE_TEST=true        # set false if INGRESS=internal and Jenkins is outside the VPC
